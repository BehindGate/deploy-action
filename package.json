{
  "name": "behindgate-deploy",
  "version": "1.0.0",
  "private": true,
  "description": "GitHub Action and GitLab CI/CD component that deploy a static site to BehindGate using the bg-deploy CLI",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build:action && npm run build:gitlab",
    "build:action": "ncc build src/index.js -o dist --license licenses.txt",
    "build:gitlab": "node script/build-gitlab-template.js",
    "lint": "eslint . && npm run lint:shell",
    "lint:shell": "sh -n src/gitlab/deploy.sh",
    "test": "node --test \"test/**/*.test.js\"",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:integration": "node --test \"test/integration/**/*.test.js\"",
    "all": "npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "actions",
    "gitlab-ci",
    "behindgate",
    "deploy",
    "static-site"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/behindgate/deploy.git"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^1.11.1",
    "@actions/exec": "^1.1.1",
    "@actions/tool-cache": "^2.0.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vercel/ncc": "^0.38.3",
    "eslint": "^9.17.0"
  }
}
