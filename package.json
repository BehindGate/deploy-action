{
  "name": "behindgate-deploy-action",
  "version": "1.1.1",
  "private": true,
  "description": "GitHub Action that deploys a static site to BehindGate using the bg-deploy CLI",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "ncc build src/index.js -o dist --license licenses.txt",
    "lint": "eslint .",
    "test": "node --test \"test/**/*.test.js\"",
    "test:unit": "node --test \"test/unit/**/*.test.js\"",
    "test:integration": "node --test \"test/integration/**/*.test.js\"",
    "all": "npm run lint && npm run test && npm run build"
  },
  "keywords": [
    "actions",
    "behindgate",
    "deploy",
    "static-site"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/behindgate/deploy-action.git"
  },
  "license": "MIT",
  "dependencies": {
    "@actions/core": "^3.0.1",
    "@actions/exec": "^3.0.0",
    "@actions/tool-cache": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@vercel/ncc": "^0.38.3",
    "eslint": "^9.17.0"
  }
}
